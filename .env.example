NODE_ENV=development
PORT=3000

# Set to true ONLY when running behind a reverse proxy. With no proxy, a client could
# forge X-Forwarded-For and plant a fake IP in the session audit trail.
TRUST_PROXY=false

# Argon2id work factor.
# Run `pnpm bench:hash` ON YOUR TARGET HARDWARE and tune so verify lands in 200-500ms.
# Remember: memoryCost is per CONCURRENT hash — 256MiB x 10 logins = 2.5GB.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Postgres. Port 5434 avoids colliding with other local containers.
DATABASE_URL="postgresql://turtleauth:turtleauth@localhost:5434/turtleauth?schema=public"
